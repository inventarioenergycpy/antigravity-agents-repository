            ws_rel.write(sec2_row, c_i, h, f_th_green)
        elif "CLOU" in h:
            ws_rel.write(sec2_row, c_i, h, f_th_blue)
        else:
            ws_rel.write(sec2_row, c_i, h, f_th_purple)
        
    cur_p_row = sec2_row + 1
    for row in despliegue_nuevo:
