# 3. Nueva Secuencia de Despliegue Mensual por Plan en Zona A (Mar-27 a Dic-27)
# Nueva asignación: CLOU: 8, 6, 17 | NANSEN: 18, 19, 12
despliegue_nuevo = [
    {"mes": "2027-03", "p18_ns": 20000, "p19_ns": 0,     "p12_ns": 0,     "p6_cl": 0,    "p17_cl": 0,     "p8_cl": 0,     "densas": 0,     "tot_cap": 20000},
    {"mes": "2027-04", "p18_ns": 13248, "p19_ns": 0,     "p12_ns": 0,     "p6_cl": 6752, "p17_cl": 0,     "p8_cl": 0,     "densas": 0,     "tot_cap": 20000},
    {"mes": "2027-05", "p18_ns": 0,     "p19_ns": 0,     "p12_ns": 0,     "p6_cl": 5923, "p17_cl": 14077, "p8_cl": 0,     "densas": 0,     "tot_cap": 20000},
    {"mes": "2027-06", "p18_ns": 0,     "p19_ns": 18390, "p12_ns": 0,     "p6_cl": 0,    "p17_cl": 1610,  "p8_cl": 0,     "densas": 0,     "tot_cap": 20000},
    {"mes": "2027-07", "p18_ns": 0,     "p19_ns": 11018, "p12_ns": 8982,  "p6_cl": 0,    "p17_cl": 0,     "p8_cl": 0,     "densas": 0,     "tot_cap": 20000},
    {"mes": "2027-08", "p18_ns": 0,     "p19_ns": 0,     "p12_ns": 13116, "p6_cl": 0,    "p17_cl": 0,     "p8_cl": 0,     "densas": 6884,  "tot_cap": 20000},
    {"mes": "2027-09", "p18_ns": 0,     "p19_ns": 0,     "p12_ns": 0,     "p6_cl": 0,    "p17_cl": 19100, "p8_cl": 900,   "densas": 0,     "tot_cap": 20000},
    {"mes": "2027-10", "p18_ns": 0,     "p19_ns": 0,     "p12_ns": 0,     "p6_cl": 0,    "p17_cl": 0,     "p8_cl": 20000, "densas": 0,     "tot_cap": 20000},
    {"mes": "2027-11", "p18_ns": 0,     "p19_ns": 0,     "p12_ns": 0,     "p6_cl": 0,    "p17_cl": 0,     "p8_cl": 6722,  "densas": 13278, "tot_cap": 20000},
    {"mes": "2027-12", "p18_ns": 0,     "p19_ns": 0,     "p12_ns": 0,     "p6_cl": 0,    "p17_cl": 0,     "p8_cl": 0,     "densas": 20000, "tot_cap": 20000}
]

def create_excel_workbook(file_path):
    wb = xlsxwriter.Workbook(file_path)
    
    # Formatos de texto y celdas
    f_title = wb.add_format({'bold': True, 'font_size': 16, 'font_name': 'Segoe UI', 'font_color': '#0f172a'})
    f_subtitle = wb.add_format({'italic': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#475569'})
    f_kpi_label = wb.add_format({'bold': True, 'font_size': 9, 'font_name': 'Segoe UI', 'font_color': '#64748b', 'align': 'center', 'bg_color': '#f8fafc', 'border': 1, 'border_color': '#cbd5e1'})
    f_kpi_val_blue = wb.add_format({'bold': True, 'font_size': 18, 'font_name': 'Segoe UI', 'font_color': '#2563eb', 'align': 'center', 'bg_color': '#ffffff', 'border': 1, 'border_color': '#cbd5e1'})
    f_kpi_val_green = wb.add_format({'bold': True, 'font_size': 18, 'font_name': 'Segoe UI', 'font_color': '#059669', 'align': 'center', 'bg_color': '#ffffff', 'border': 1, 'border_color': '#cbd5e1'})
    f_kpi_val_purple = wb.add_format({'bold': True, 'font_size': 18, 'font_name': 'Segoe UI', 'font_color': '#7c3aed', 'align': 'center', 'bg_color': '#ffffff', 'border': 1, 'border_color': '#cbd5e1'})
    f_kpi_val_amber = wb.add_format({'bold': True, 'font_size': 18, 'font_name': 'Segoe UI', 'font_color': '#d97706', 'align': 'center', 'bg_color': '#ffffff', 'border': 1, 'border_color': '#cbd5e1'})
    f_kpi_val_red = wb.add_format({'bold': True, 'font_size': 18, 'font_name': 'Segoe UI', 'font_color': '#dc2626', 'align': 'center', 'bg_color': '#ffffff', 'border': 1, 'border_color': '#cbd5e1'})
    
    f_th_navy = wb.add_format({'bold': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#ffffff', 'bg_color': '#0f172a', 'align': 'center', 'valign': 'vcenter', 'border': 1, 'text_wrap': True})
    f_th_blue = wb.add_format({'bold': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#ffffff', 'bg_color': '#1e3a8a', 'align': 'center', 'valign': 'vcenter', 'border': 1, 'text_wrap': True})
    f_th_purple = wb.add_format({'bold': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#ffffff', 'bg_color': '#581c87', 'align': 'center', 'valign': 'vcenter', 'border': 1, 'text_wrap': True})
    f_th_amber = wb.add_format({'bold': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#ffffff', 'bg_color': '#92400e', 'align': 'center', 'valign': 'vcenter', 'border': 1, 'text_wrap': True})
    f_th_green = wb.add_format({'bold': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#ffffff', 'bg_color': '#065f46', 'align': 'center', 'valign': 'vcenter', 'border': 1, 'text_wrap': True})
    f_th_cyan = wb.add_format({'bold': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#ffffff', 'bg_color': '#0e7490', 'align': 'center', 'valign': 'vcenter', 'border': 1, 'text_wrap': True})
    f_th_rose = wb.add_format({'bold': True, 'font_size': 10, 'font_name': 'Segoe UI', 'font_color': '#ffffff', 'bg_color': '#9f1239', 'align': 'center', 'valign': 'vcenter', 'border': 1, 'text_wrap': True})
    
    f_td_text = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'border': 1, 'border_color': '#e2e8f0'})
    f_td_center = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'align': 'center', 'border': 1, 'border_color': '#e2e8f0'})
    f_td_num = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'num_format': '#,##0', 'border': 1, 'border_color': '#e2e8f0'})
    f_td_num_bold = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'num_format': '#,##0', 'border': 1, 'border_color': '#e2e8f0'})
    f_td_pct = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'num_format': '0.0%', 'border': 1, 'border_color': '#e2e8f0', 'align': 'center'})
    f_td_green = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'num_format': '#,##0', 'font_color': '#059669', 'border': 1, 'border_color': '#e2e8f0'})
    f_td_red = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'num_format': '#,##0', 'font_color': '#dc2626', 'border': 1, 'border_color': '#e2e8f0'})
    f_td_amber = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'num_format': '#,##0', 'font_color': '#d97706', 'border': 1, 'border_color': '#e2e8f0'})
    f_td_total = wb.add_format({'font_name': 'Segoe UI', 'font_size': 10, 'bold': True, 'bg_color': '#f1f5f9', 'num_format': '#,##0', 'border': 1, 'border_color': '#94a3b8'})
    f_td_prio_urg = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'font_color': '#991b1b', 'bg_color': '#fee2e2', 'align': 'center', 'border': 1})
    f_td_prio_med = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'font_color': '#92400e', 'bg_color': '#fef3c7', 'align': 'center', 'border': 1})
    f_td_prio_ok = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'font_color': '#166534', 'bg_color': '#dcfce7', 'align': 'center', 'border': 1})
    f_tag_clou = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'font_color': '#0284c7', 'bg_color': '#e0f2fe', 'align': 'center', 'border': 1})
    f_tag_nansen = wb.add_format({'font_name': 'Segoe UI', 'font_size': 9, 'bold': True, 'font_color': '#15803d', 'bg_color': '#dcfce7', 'align': 'center', 'border': 1})

    # ==========================================
    # HOJA 1: TABLERO Y GRÁFICAS EJECUTIVAS
    # ==========================================
    ws_dash = wb.add_worksheet("Tablero y Gráficas")
    ws_dash.hide_gridlines(False)
    ws_dash.set_column('A:A', 3)
    ws_dash.set_column('B:G', 16)
    
    ws_dash.write('B2', "Tablero Ejecutivo: Simulación Despliegue AMI EPEC 307k", f_title)
    ws_dash.write('B3', "Licitación N° 5573 · Nueva Asignación Tecnológica: CLOU (Planes 8, 6, 17) y NANSEN (Planes 18, 19, 12)", f_subtitle)
    
    # Tarjetas KPI
    ws_dash.merge_range('B5:C5', "STOCK TOTAL EPEC", f_kpi_label)
    ws_dash.merge_range('B6:C6', "307.000", f_kpi_val_blue)
    
    ws_dash.merge_range('D5:E5', "ZONA A (CAPITAL 10m)", f_kpi_label)
    ws_dash.merge_range('D6:E6', "200.000", f_kpi_val_purple)
    
    ws_dash.merge_range('F5:G5', "INTERIOR (CUOTA 22m)", f_kpi_label)
    ws_dash.merge_range('F6:G6', "107.000", f_kpi_val_amber)
    
    ws_dash.merge_range('B8:C8', "TOTAL PLANES CLOU (8, 6, 17)", f_kpi_label)
    ws_dash.merge_range('B9:C9', "75.084", f_kpi_val_blue)
    
    ws_dash.merge_range('D8:E8', "TOTAL PLANES NANSEN (18, 19, 12)", f_kpi_label)
    ws_dash.merge_range('D9:E9', "84.754", f_kpi_val_green)
    
    ws_dash.merge_range('F8:G8', "QUIEBRE PLAN 8 (PEND. RELEV)", f_kpi_label)
    ws_dash.merge_range('F9:G9', "27.534 (99,7%)", f_kpi_val_red)

    # ==========================================
    # HOJA 2: CRONOGRAMA MAESTRO
    # ==========================================
    ws_data = wb.add_worksheet("Cronograma Maestro")
    ws_data.set_row(0, 28)
    ws_data.set_row(1, 26)
    
    headers = [
        ("Periodo", 12, f_th_navy),
        ("Mes N° Int.", 11, f_th_navy),
        ("Ingreso Sanxing", 14, f_th_blue),
        ("Ingreso CLOU (EPEC)", 14, f_th_blue),
        ("Ingreso Mes EPEC", 14, f_th_blue),
        ("Stock EPEC Acumulado", 16, f_th_blue),
        ("Inst. Capital Mensual", 15, f_th_purple),
        ("Inst. Capital Acumulada", 16, f_th_purple),
        ("Inst. Interior Mensual", 15, f_th_amber),
        ("Inst. Interior Acumulada", 16, f_th_amber),
        ("D28 Río Cuarto Mes", 14, f_th_navy),
        ("D8 Villa María Mes", 14, f_th_navy),
        ("D18 San Francisco Mes", 14, f_th_navy),
        ("D23 Villa Allende Mes", 14, f_th_navy),
        ("Inst. Total Provincial Mes", 16, f_th_green),
        ("Inst. Total Provincial Acum.", 17, f_th_green),
        ("Stock Remanente Almacén", 17, f_th_green),
        ("Estado Stock Interior", 22, f_th_navy),
        ("Cuadrillas Capital", 13, f_th_navy),
        ("Cuadrillas Interior", 13, f_th_navy),
        ("Cuadrillas Totales", 13, f_th_navy)
    ]
    
    for c_idx, (h_title, h_width, h_fmt) in enumerate(headers):
        ws_data.set_column(c_idx, c_idx, h_width)
        ws_data.write(1, c_idx, h_title, h_fmt)
        
    ws_data.merge_range(0, 0, 0, 1, "CALENDARIO", f_th_navy)
    ws_data.merge_range(0, 2, 0, 5, "FLUJO DE STOCK EPEC (LICITACIÓN 5573)", f_th_blue)
    ws_data.merge_range(0, 6, 0, 7, "ZONA A (CÓRDOBA CAPITAL)", f_th_purple)
    ws_data.merge_range(0, 8, 0, 9, "INTERIOR DE LA PROVINCIA", f_th_amber)
    ws_data.merge_range(0, 10, 0, 13, "DESGLOSE DISTRITAL DEL INTERIOR (MENSUAL)", f_th_navy)
    ws_data.merge_range(0, 14, 0, 16, "CONSOLIDADO PROVINCIAL Y ALMACÉN", f_th_green)
    ws_data.merge_range(0, 17, 0, 20, "OPERACIÓN Y CUADRILLAS", f_th_navy)
    
    for r_idx, r in enumerate(data_rows, start=2):
        ws_data.write(r_idx, 0, r["mes"], f_td_center)
        ws_data.write(r_idx, 1, str(r["mes_nro"]), f_td_center)
        ws_data.write(r_idx, 2, r["sx"], f_td_num)
        ws_data.write(r_idx, 3, r["clou"], f_td_num)
        ws_data.write(r_idx, 4, r["ing_mes"], f_td_num_bold)
        ws_data.write(r_idx, 5, r["stk_ing_acum"], f_td_num_bold)
        ws_data.write(r_idx, 6, r["inst_cap"], f_td_num)
        ws_data.write(r_idx, 7, r["inst_cap_acum"], f_td_num_bold)
        ws_data.write(r_idx, 8, r["inst_int"], f_td_num)
        ws_data.write(r_idx, 9, r["inst_int_acum"], f_td_num_bold)
        ws_data.write(r_idx, 10, r["rc"], f_td_num)
        ws_data.write(r_idx, 11, r["vm"], f_td_num)
        ws_data.write(r_idx, 12, r["sf"], f_td_num)
        ws_data.write(r_idx, 13, r["va"], f_td_num)
        ws_data.write(r_idx, 14, r["inst_tot_mes"], f_td_num_bold)
        ws_data.write(r_idx, 15, r["inst_tot_acum"], f_td_num_bold)
        
        if r["stk_remanente"] == 0:
            ws_data.write(r_idx, 16, r["stk_remanente"], f_td_red)
        elif r["stk_remanente"] < 20000:
            ws_data.write(r_idx, 16, r["stk_remanente"], f_td_amber)
        else:
            ws_data.write(r_idx, 16, r["stk_remanente"], f_td_green)
            
        ws_data.write(r_idx, 17, r["estado_int"], f_td_text)
        ws_data.write(r_idx, 18, r["cuad_cap"], f_td_center)
        ws_data.write(r_idx, 19, r["cuad_int"], f_td_center)
        ws_data.write(r_idx, 20, r["cuad_tot"], f_td_center)
        
    last_row = len(data_rows) + 1

    # ==========================================
    # HOJA 3: DETALLE DISTRITOS INTERIOR
    # ==========================================
    ws_int = wb.add_worksheet("Detalle Distritos Interior")
    ws_int.set_column('A:A', 4)
    ws_int.set_column('B:B', 12)
    ws_int.set_column('C:C', 20)
    ws_int.set_column('D:D', 28)
    ws_int.set_column('E:K', 16)
    
    ws_int.write('B2', "Resumen de Cobertura y Déficit en el Interior (107k Stock vs. 203k Suministros)", f_title)
    ws_int.write('B3', "Distribución proporcional para horizonte de 22 meses (Agotamiento en Feb-2028 / Mes 12)", f_subtitle)
    
    int_summary_headers = [
        "Prioridad", "Distrito", "Nombre Distrito", "Localidad",
        "Suministros Censo", "Participación %", "Ritmo Mensual (u/m)",
        "Medidores Instalados", "Suministros Pendientes", "Cobertura Final %"
    ]
    for c_i, h in enumerate(int_summary_headers, start=1):
        ws_int.write(4, c_i, h, f_th_navy)
        
    int_dist_data = [
        (1, 28, "Río Cuarto", "RÍO CUARTO", 88224, 0.4343, 4010.2, 46471, 41753, 0.5267),
        (2, 8,  "Villa María", "VILLA MARÍA + VILLA NUEVA", 63282, 0.3115, 2876.5, 33333, 29949, 0.5267),
        (3, 18, "San Francisco", "SAN FRANCISCO", 36776, 0.1810, 1671.6, 19371, 17405, 0.5267),
        (4, 23, "Villa Allende", "VILLA ALLENDE (inc. 13 en D1)", 14855, 0.0731, 675.2, 7825, 7030, 0.5267)
    ]
    for r_i, d in enumerate(int_dist_data, start=5):
        ws_int.write(r_i, 1, d[0], f_td_center)
        ws_int.write(r_i, 2, d[1], f_td_center)
        ws_int.write(r_i, 3, d[2], f_td_text)
        ws_int.write(r_i, 4, d[3], f_td_text)
        ws_int.write(r_i, 5, d[4], f_td_num)
        ws_int.write(r_i, 6, d[5], f_td_pct)
        ws_int.write(r_i, 7, d[6], f_td_num)
        ws_int.write(r_i, 8, d[7], f_td_num_bold)
        ws_int.write(r_i, 9, d[8], f_td_red)
        ws_int.write(r_i, 10, d[9], f_td_pct)
        
    tot_row = 5 + len(int_dist_data)
    ws_int.write(tot_row, 1, "TOTAL", f_td_total)
    ws_int.write(tot_row, 2, "-", f_td_total)
