        'marker':     {'type': 'circle', 'size': 4, 'color': '#1e40af'}
    })
    chart4.add_series({
        'name':       ['Detalle Distritos Interior', start_table2_row, 4],
        'categories': ['Detalle Distritos Interior', first_int_r, 1, last_int_row, 1],
        'values':     ['Detalle Distritos Interior', first_int_r, 4, last_int_row, 4],
        'line':       {'color': '#0284c7', 'width': 2.2},
        'marker':     {'type': 'square', 'size': 4, 'color': '#0284c7'}
    })
    chart4.add_series({
        'name':       ['Detalle Distritos Interior', start_table2_row, 5],
        'categories': ['Detalle Distritos Interior', first_int_r, 1, last_int_row, 1],
        'values':     ['Detalle Distritos Interior', first_int_r, 5, last_int_row, 5],
        'line':       {'color': '#d97706', 'width': 2.2},
        'marker':     {'type': 'diamond', 'size': 4, 'color': '#d97706'}
    })
    chart4.add_series({
        'name':       ['Detalle Distritos Interior', start_table2_row, 6],
        'categories': ['Detalle Distritos Interior', first_int_r, 1, last_int_row, 1],
        'values':     ['Detalle Distritos Interior', first_int_r, 6, last_int_row, 6],
        'line':       {'color': '#e11d48', 'width': 2.2},
        'marker':     {'type': 'triangle', 'size': 4, 'color': '#e11d48'}
    })
    ws_dash.insert_chart('L29', chart4)

    # GRÁFICA 5: Estado de Relevamiento por Plan (Zona A)
    chart5 = wb.add_chart({'type': 'bar', 'subtype': 'stacked'})
    chart5.set_title({'name': 'Zona A: Suministros Relevados vs. Pendientes de Relevamiento por Plan', 'name_font': {'size': 11, 'bold': True}})
    chart5.set_x_axis({'name': 'Suministros', 'name_font': {'size': 9}, 'num_format': '#,##0'})
    chart5.set_y_axis({'name': 'Plan de Lectura', 'name_font': {'size': 9}})
    chart5.set_legend({'position': 'top'})
    chart5.set_size({'width': 650, 'height': 330})
    
    chart5.add_series({
        'name':       ['Relevamiento y Planes Zona A', 4, 4],
        'categories': ['Relevamiento y Planes Zona A', 5, 1, tot_rel_row - 1, 1],
        'values':     ['Relevamiento y Planes Zona A', 5, 4, tot_rel_row - 1, 4],
        'fill':       {'color': '#10b981'},
        'border':     {'color': '#059669'}
    })
    chart5.add_series({
        'name':       ['Relevamiento y Planes Zona A', 4, 2],
        'categories': ['Relevamiento y Planes Zona A', 5, 1, tot_rel_row - 1, 1],
        'values':     ['Relevamiento y Planes Zona A', 5, 2, tot_rel_row - 1, 2],
        'fill':       {'color': '#ef4444'},
        'border':     {'color': '#dc2626'}
    })
    ws_dash.insert_chart('B47', chart5)

    # GRÁFICA 6: Despliegue Mensual por Plan en Zona A (NUEVA ASIGNACIÓN TECNOLÓGICA)
    chart6 = wb.add_chart({'type': 'column', 'subtype': 'stacked'})
    chart6.set_title({'name': 'Zona A: Despliegue por Plan con Nueva Tecnología (CLOU: 8,6,17 | NANSEN: 18,19,12)', 'name_font': {'size': 11, 'bold': True}})
    chart6.set_x_axis({'name': 'Mes / Periodo (2027)', 'name_font': {'size': 9}})
    chart6.set_y_axis({'name': 'Medidores / Mes', 'name_font': {'size': 9}, 'num_format': '#,##0'})
    chart6.set_legend({'position': 'top'})
    chart6.set_size({'width': 650, 'height': 330})
    
    col_colors_new = [
        (2, "#15803d"), # P18 Nansen (Verde Oscuro)
        (3, "#22c55e"), # P19 Nansen (Verde Claro)
        (4, "#86efac"), # P12 Nansen (Verde Lima)
        (5, "#0284c7"), # P6 CLOU (Azul Cielo)
        (6, "#2563eb"), # P17 CLOU (Azul Royal)
        (7, "#1e3a8a"), # P8 CLOU (Azul Marino)
        (8, "#94a3b8")  # Cuencas Densas (Gris)
    ]
    for c_idx, color in col_colors_new:
        chart6.add_series({
            'name':       ['Relevamiento y Planes Zona A', sec2_row, c_idx],
            'categories': ['Relevamiento y Planes Zona A', sec2_row + 1, 1, last_p_row, 1],
            'values':     ['Relevamiento y Planes Zona A', sec2_row + 1, c_idx, last_p_row, c_idx],
            'fill':       {'color': color}
        })
    ws_dash.insert_chart('L47', chart6)
    
    wb.close()
    print(f"Archivo Excel generado con éxito: {file_path}")

create_excel_workbook(EXCEL_LOCAL)
create_excel_workbook(EXCEL_DOWNLOADS)
