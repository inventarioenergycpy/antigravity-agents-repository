"""
Script generador del Excel Ejecutivo con Gráficas Nativas de Ingeniería:
Simulación de Despliegue AMI EPEC 307k vs. Cooperativas 93k (Horizonte 22 Meses)
+ Diagnóstico de Relevamiento por Plan (Planes 17, 18, 19, 8, 12, 6)
+ Nueva Asignación Tecnológica Zona A:
    CLOU:   Plan 8, Plan 6, Plan 17
    NANSEN: Plan 18, Plan 19, Plan 12
Licitación Pública N° 5573 / Res. 0653/2026
"""

import os, sys
import xlsxwriter
import pandas as pd

sys.stdout.reconfigure(encoding="utf-8")

BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA_DIR = os.path.join(BASE, "data")
DOWNLOADS_DIR = r"C:\Users\jidiaz\Downloads"

EXCEL_LOCAL = os.path.join(DATA_DIR, "Simulacion_Despliegue_AMI_EPEC_307k_Interior_22m.xlsx")
EXCEL_DOWNLOADS = os.path.join(DOWNLOADS_DIR, "Simulacion_Despliegue_AMI_EPEC_307k_Interior_22m.xlsx")

# 1. Definición de la Línea de Tiempo (Feb-2027 a Dic-2028 = 23 periodos)
periodos = [
    {"mes": "2027-02", "mes_idx": 0, "sx": 34000, "clou": 0},
    {"mes": "2027-03", "mes_idx": 1, "sx": 31000, "clou": 42000},
    {"mes": "2027-04", "mes_idx": 2, "sx": 45000, "clou": 0},
    {"mes": "2027-05", "mes_idx": 3, "sx": 45000, "clou": 0},
    {"mes": "2027-06", "mes_idx": 4, "sx": 45000, "clou": 0},
    {"mes": "2027-07", "mes_idx": 5, "sx": 0,     "clou": 0},
    {"mes": "2027-08", "mes_idx": 6, "sx": 0,     "clou": 0},
    {"mes": "2027-09", "mes_idx": 7, "sx": 0,     "clou": 41500},
    {"mes": "2027-10", "mes_idx": 8, "sx": 0,     "clou": 23500}, # 18k descontados a Coop en Esc. A
    {"mes": "2027-11", "mes_idx": 9, "sx": 0,     "clou": 0},
    {"mes": "2027-12", "mes_idx": 10, "sx": 0,    "clou": 0},     # 75k descontados a Coop en Esc. A
    {"mes": "2028-01", "mes_idx": 11, "sx": 0,    "clou": 0},
    {"mes": "2028-02", "mes_idx": 12, "sx": 0,    "clou": 0},
    {"mes": "2028-03", "mes_idx": 13, "sx": 0,    "clou": 0},
    {"mes": "2028-04", "mes_idx": 14, "sx": 0,    "clou": 0},
    {"mes": "2028-05", "mes_idx": 15, "sx": 0,    "clou": 0},
    {"mes": "2028-06", "mes_idx": 16, "sx": 0,    "clou": 0},
    {"mes": "2028-07", "mes_idx": 17, "sx": 0,    "clou": 0},
    {"mes": "2028-08", "mes_idx": 18, "sx": 0,    "clou": 0},
    {"mes": "2028-09", "mes_idx": 19, "sx": 0,    "clou": 0},
    {"mes": "2028-10", "mes_idx": 20, "sx": 0,    "clou": 0},
    {"mes": "2028-11", "mes_idx": 21, "sx": 0,    "clou": 0},
    {"mes": "2028-12", "mes_idx": 22, "sx": 0,    "clou": 0}
]

# Parámetros Interior
censo = {
    "Rio_Cuarto": 88224,
    "Villa_Maria": 63282,
    "San_Francisco": 36776,
    "Villa_Allende": 14855
}
total_censo_int = sum(censo.values())
stock_total_int = 107000
ritmo_mensual_teorico_int = total_censo_int / 22 # 9233.5

data_rows = []
stk_ing_acum = 0
inst_cap_acum = 0
inst_int_acum = 0
inst_rc_acum = 0
inst_vm_acum = 0
inst_sf_acum = 0
inst_va_acum = 0
stk_rem_interior = stock_total_int

for p in periodos:
    m = p["mes"]
    idx = p["mes_idx"]
    sx = p["sx"]
    clou = p["clou"]
    ing_mes = sx + clou
    stk_ing_acum += ing_mes
    
    # Capital: 20k/mes entre Mar-27 y Dic-27 (idx 1 a 10)
    if 1 <= idx <= 10:
        inst_cap = 20000
    else:
        inst_cap = 0
    inst_cap_acum += inst_cap
    
    # Interior: 22 meses entre Mar-27 y Dic-28 (idx 1 a 22)
    if idx == 0:
        inst_int = 0
        rc = vm = sf = va = 0
        estado_int = "Inicio de Acopio en Almacén"
    else:
        if stk_rem_interior <= 0:
            inst_int = 0
            rc = vm = sf = va = 0
            estado_int = "AGOTADO (0 STOCK)"
        elif stk_rem_interior >= ritmo_mensual_teorico_int:
            inst_int = ritmo_mensual_teorico_int
            rc = censo["Rio_Cuarto"] / 22
            vm = censo["Villa_Maria"] / 22
            sf = censo["San_Francisco"] / 22
            va = censo["Villa_Allende"] / 22
            stk_rem_interior -= inst_int
            estado_int = f"Activo (Stock: {stk_rem_interior:,.0f})"
        else:
            inst_int = stk_rem_interior
            factor = stk_rem_interior / ritmo_mensual_teorico_int
            rc = (censo["Rio_Cuarto"] / 22) * factor
            vm = (censo["Villa_Maria"] / 22) * factor
            sf = (censo["San_Francisco"] / 22) * factor
            va = (censo["Villa_Allende"] / 22) * factor
            stk_rem_interior = 0
            estado_int = "AGOTAMIENTO DEFINITIVO DE STOCK"
            
    inst_int_acum += inst_int
    inst_rc_acum += rc
    inst_vm_acum += vm
    inst_sf_acum += sf
    inst_va_acum += va
    
    inst_total_mes = inst_cap + inst_int
    inst_total_acum = inst_cap_acum + inst_int_acum
    stk_remanente_almacen = stk_ing_acum - inst_total_acum
    
    # Cuadrillas
    cuad_cap = round(inst_cap / (22 * 18), 1) if inst_cap > 0 else 0
    cuad_int = round(inst_int / (22 * 14), 1) if inst_int > 0 else 0
    cuad_tot = cuad_cap + cuad_int
    
    data_rows.append({
        "mes": m,
        "mes_nro": idx if idx > 0 else "-",
        "sx": sx,
        "clou": clou,
        "ing_mes": ing_mes,
        "stk_ing_acum": stk_ing_acum,
        "inst_cap": inst_cap,
        "inst_cap_acum": inst_cap_acum,
        "inst_int": inst_int,
        "inst_int_acum": inst_int_acum,
        "rc": rc,
        "rc_acum": inst_rc_acum,
        "vm": vm,
        "vm_acum": inst_vm_acum,
        "sf": sf,
        "sf_acum": inst_sf_acum,
        "va": va,
        "va_acum": inst_va_acum,
        "inst_tot_mes": inst_total_mes,
        "inst_tot_acum": inst_total_acum,
        "stk_remanente": stk_remanente_almacen,
        "estado_int": estado_int,
        "cuad_cap": cuad_cap,
        "cuad_int": cuad_int,
        "cuad_tot": cuad_tot
    })

