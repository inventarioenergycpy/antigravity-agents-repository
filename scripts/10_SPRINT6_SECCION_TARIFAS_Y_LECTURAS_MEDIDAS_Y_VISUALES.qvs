/// ==============================================================================
/// EPEC - PROTELEM / TELEMEDICIÓN AMI ZONA A
/// SPRINT 6: SECCIONES TARIFAS Y LECTURAS (MATRICES TARIFARIAS, PCT Y CUADRANTES MDM)
/// Páginas Power BI Equivalentes:
///   - ReportSection5007fbda819c24e70b01 ("TARIFAS")
///   - ReportSection5765ed7d9baec9ee31e9 ("LECTURAS")
/// Generado por: Squad Ágil Multi-Agente (PM Gemini 3.8 Flash High + Agentes 11 & 02)
/// ==============================================================================

TRACE >>> ==========================================================;
TRACE >>> INICIANDO SPRINT 6: SECCIONES TARIFAS Y LECTURAS;
TRACE >>> ==========================================================;

// ------------------------------------------------------------------------------
// 1. LÓGICA DE CANALES Y CUADRANTES DE MEDICIÓN (cuadrantes_medidos)
// ------------------------------------------------------------------------------
// Permite auditar qué canales de energía activa, reactiva y demanda (E, EAR, EAP, EAV, DR, DP, DV)
// son transmitidos efectivamente por cada marca de medidor inteligente (CLOU, NANSEN, etc.).

[Canales_Lectura_Temp]:
LOAD
    Num(MEDIDOR)                                        AS MEDIDOR,
    // En caso de medidores monofásicos estándar el canal base es Energía Activa ('E')
    // En medidores inteligentes multifunción se concatenan los cuadrantes tarifarios medidos
    If(Match(TELEMEDIBLE, 'CLOU', 'NANSEN') > 0 and Match(factura_resto_pico_valle, 'Factura RESTO - PICO - VALLE') > 0,
       'E,EAR,EAP,EAV,DR,DP,DV',
       If(Match(TELEMEDIBLE, 'CLOU', 'NANSEN') > 0, 'E,EAR', 'E')
    )                                                   AS cuadrantes_medidos
RESIDENT [vt_protelem];

LEFT JOIN ([vt_protelem])
LOAD
    MEDIDOR,
    cuadrantes_medidos
RESIDENT [Canales_Lectura_Temp];

DROP TABLE [Canales_Lectura_Temp];

TRACE >>> ==========================================================;
TRACE >>> SPRINT 6: PRE-CÁLCULO DE CUADRANTES Y TARIFAS FINALIZADO;
TRACE >>> ==========================================================;


