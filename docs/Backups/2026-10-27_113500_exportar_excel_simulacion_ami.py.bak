    ws_rel.write(tot_rel_row, 3, 0.3944, f_td_total)
    ws_rel.write(tot_rel_row, 4, 96796, f_td_total)
    ws_rel.write(tot_rel_row, 5, 0.6056, f_td_total)
    ws_rel.write(tot_rel_row, 6, 159838, f_td_total)
