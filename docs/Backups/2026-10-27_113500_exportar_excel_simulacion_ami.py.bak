    ws_rel.write(tot_rel_row, 8, "-", f_td_total)
    ws_rel.write(tot_rel_row, 9, "Ene-27 a Sep-27", f_td_total)
    ws_rel.write(tot_rel_row, 10, 7005, f_td_total)
    ws_rel.write(tot_rel_row, 11, 15.9, f_td_total)

    # Tabla Despliegue Mensual por Plan en Zona A (NUEVA ASIGNACIÓN TECNOLÓGICA)
    sec2_row = tot_rel_row + 3
