    headers_plan_desp = [
        "Periodo", "Plan 18 (NANSEN)", "Plan 19 (NANSEN)", "Plan 12 (NANSEN)",
        "Plan 6 (CLOU)", "Plan 17 (CLOU)", "Plan 8 (CLOU)", "Cuencas Densas Ady.", "Total Capital Mes"
    ]
