        ws_rel.write(cur_p_row, 4, row["p12_ns"], f_td_num)
        ws_rel.write(cur_p_row, 5, row["p6_cl"], f_td_num)
        ws_rel.write(cur_p_row, 6, row["p17_cl"], f_td_num)
        ws_rel.write(cur_p_row, 7, row["p8_cl"], f_td_num)
        ws_rel.write(cur_p_row, 8, row["densas"], f_td_num)
        ws_rel.write(cur_p_row, 9, row["tot_cap"], f_td_num_bold)
        cur_p_row += 1
        
    last_p_row = cur_p_row - 1
    
