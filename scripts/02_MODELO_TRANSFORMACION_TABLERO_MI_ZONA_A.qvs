/// ==============================================================================
/// EPEC - PROTELEM / TELEMEDICIÓN AMI ZONA A
/// SCRIPT DE TRANSFORMACIÓN Y MODELADO DE DATOS (APP QLIK SENSE)
/// Módulo: Capa 2 - Transformación, Reglas de Negocio Precalculadas y Modelo Dimensional
/// Generado por: Squad Ágil Multi-Agente (PM Gemini 3.8 Flash High + Agentes 11 & 02)
/// Arquitectura: Pre-cálculo masivo en Script -> Set Analysis Mínimo en Frontend
/// ==============================================================================

SET ThousandSep='.';
SET DecimalSep=',';
SET MoneyThousandSep='.';
SET MoneyDecimalSep=',';
SET MoneyFormat='$#.##0,00;$-#.##0,00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='DD/MM/YYYY';
SET TimestampFormat='DD/MM/YYYY hh:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='es-AR';

TRACE >>> ==========================================================;
TRACE >>> [FASE 1]: TABLAS DE MAPEO Y CONFIGURACIÓN TARIFARIA;
TRACE >>> ==========================================================;

