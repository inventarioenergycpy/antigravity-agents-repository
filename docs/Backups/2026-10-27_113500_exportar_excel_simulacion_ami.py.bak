    # ==========================================
    ws_esc = wb.add_worksheet("Escenarios Cooperativas")
    ws_esc.set_column('A:A', 4)
    ws_esc.set_column('B:B', 30)
    ws_esc.set_column('C:D', 42)
    
    ws_esc.write('B2', "Análisis Comparativo: Escenario A (CLOU) vs. Escenario B (SANXING)", f_title)
    ws_esc.write('B3', "Evaluación de impacto sobre stock, flujo de entregas y cumplimiento de plazos", f_subtitle)
    
    ws_esc.write('B5', "Criterio de Evaluación", f_th_navy)
    ws_esc.write('C5', "Escenario A: Descuento de CLOU (OP 27133)", f_th_green)
    ws_esc.write('D5', "Escenario B: Descuento de SANXING (OP 27131)", f_th_amber)
    
    esc_rows = [
        ("Stock EPEC Resultante", "200.000 Sanxing + 107.000 CLOU = 307.000 MI", "107.000 Sanxing + 200.000 CLOU = 307.000 MI"),
        ("Disponibilidad en Almacén", "Temprana (Feb-Jun 2027: 200k Sanxing disponibles)", "Tardía (CLOU entrega en Sep, Oct y Dic 2027)"),
        ("Cumplimiento Zona A (200k en 10m)", "100% Factible (Planes 18 y 19 activos en Mar-Jun)", "Incumplible (Parálisis de 4 meses entre Abr y Ago)"),
        ("Abastecimiento Interior (107k)", "100% Homogéneo en Sanxing (Stock asegurado en Jun-27)", "Tensión de stock (Sanxing al límite exacto sin margen)"),
        ("Lote absorbido por Cooperativas", "CLOU E4 (16/12/2027) de 75k + 18k de CLOU E3", "Sanxing E4 y E5 de Mayo-Junio 2027"),
        ("Alineación con Concentradores", "3.000 Sanford y 1.605 Nicema asignados por zona", "Incompatibilidad de cabeceras PLC en subestaciones"),
        ("Meses de Parálisis de Cuadrillas", "0 Meses (Flujo continuo)", "4 Meses (Mayo, Junio, Julio, Agosto 2027)"),
        ("Dictamen Técnico", "RECOMENDADO / FACTIBLE", "DESACONSEJADO / CRÍTICO")
    ]
    
    for r_i, (crit, ea, eb) in enumerate(esc_rows, start=6):
        ws_esc.write(r_i, 1, crit, f_td_text)
