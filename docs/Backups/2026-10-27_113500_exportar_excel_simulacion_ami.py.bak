    ws_int.write(tot_row, 4, "-", f_td_total)
    ws_int.write(tot_row, 5, 203137, f_td_total)
    ws_int.write(tot_row, 6, 1.0, f_td_total)
    ws_int.write(tot_row, 7, 9233.5, f_td_total)
    ws_int.write(tot_row, 8, 107000, f_td_total)
    ws_int.write(tot_row, 9, 96137, f_td_total)
    ws_int.write(tot_row, 10, 0.5267, f_td_total)

    # Tabla mensual acumulada distrital
    start_table2_row = tot_row + 3
    ws_int.write(start_table2_row - 1, 1, "Evolución Mensual Acumulada por Distrito del Interior", f_title)
    
    headers_int_monthly = [
        "Periodo", "Mes N°", "D28 Río Cuarto Acum.", "D8 Villa María Acum.",
        "D18 San Francisco Acum.", "D23 Villa Allende Acum.", "Total Interior Acumulado", "Stock Interior Remanente"
    ]
    for c_i, h in enumerate(headers_int_monthly, start=1):
        ws_int.write(start_table2_row, c_i, h, f_th_cyan)
        
    r_cur_row = start_table2_row + 1
    for r in data_rows:
        ws_int.write(r_cur_row, 1, r["mes"], f_td_center)
        ws_int.write(r_cur_row, 2, str(r["mes_nro"]), f_td_center)
        ws_int.write(r_cur_row, 3, r["rc_acum"], f_td_num)
        ws_int.write(r_cur_row, 4, r["vm_acum"], f_td_num)
        ws_int.write(r_cur_row, 5, r["sf_acum"], f_td_num)
        ws_int.write(r_cur_row, 6, r["va_acum"], f_td_num)
        ws_int.write(r_cur_row, 7, r["inst_int_acum"], f_td_num_bold)
        
        stk_rem_i = stock_total_int - r["inst_int_acum"]
        if stk_rem_i <= 0:
            ws_int.write(r_cur_row, 8, 0, f_td_red)
        else:
            ws_int.write(r_cur_row, 8, stk_rem_i, f_td_green)
            
        r_cur_row += 1
        
    last_int_row = r_cur_row - 1

    # ==============================================================
    # HOJA 4: RELEVAMIENTO Y PLANES ZONA A (NUEVA ASIGNACIÓN TECNOLÓGICA)
    # ==============================================================
    ws_rel = wb.add_worksheet("Relevamiento y Planes Zona A")
    ws_rel.set_column('A:A', 3)
    ws_rel.set_column('B:B', 14)
    ws_rel.set_column('C:C', 18)
    ws_rel.set_column('D:D', 15)
    ws_rel.set_column('E:E', 18)
